# Aura Vital Star — Backend Email & Database Configuration

PORT=5000

# ==============================================================================
# SMTP SERVER CONFIGURATION (Custom SMTP from Hostinger / cPanel / Zoho / Outlook / Gmail)
# ==============================================================================
# SMTP Server Host (e.g. neo.herosite.pro, mail.auravitalstar.ca, etc.)
SMTP_HOST=neo.herosite.pro

# SMTP Server Port (587 for TLS/STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to true if using Port 465 (SSL), false for Port 587 (TLS/STARTTLS)
SMTP_SECURE=false

# SMTP Username / Login Email
SMTP_USER=noreply@auravitalstar.ca

# SMTP Password or App Password
SMTP_PASS=C0d3kap#123

# Sender Display Name & From Address in Outgoing Emails
FROM_NAME="Aura Vital Star Concierge"
FROM_EMAIL=noreply@auravitalstar.ca

# ==============================================================================
# ADMIN NOTIFICATION DESTINATION
# ==============================================================================
# Where admin notifications for contact inquiries and new bookings will be delivered:
ADMIN_EMAIL=auravitalstar@gmail.com

# ==============================================================================
# BACKWARDS COMPATIBILITY
# ==============================================================================
GMAIL_USER=noreply@auravitalstar.ca
GMAIL_APP_PASSWORD=C0d3kap#123
