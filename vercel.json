{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/crm",
      "destination": "/crm/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/crm/:match*",
      "destination": "/crm/index.html"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings.js"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp.js"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/verify-otp.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/crm.js?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(webp|avif|jpg|jpeg|png|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
