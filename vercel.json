{
  "rewrites": [
    {
      "source": "/crm/:match*",
      "destination": "/crm/index.html"
    },
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/verify-otp"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/crm"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(webp|avif|jpg|jpeg|png|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
