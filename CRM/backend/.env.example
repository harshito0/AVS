# ============================================================
# AURA VITAL STAR CRM — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Server
PORT=4000
NODE_ENV=development

# ============================================================
# DATABASE — PostgreSQL
# ============================================================
# For production:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avs_crm?schema=public"
# For local SQLite dev (zero-setup):
DATABASE_URL="file:./dev.db"

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ============================================================
# SMTP Email (existing AVS email system)
# ============================================================
SMTP_HOST=neo.herosite.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@auravitalstar.ca
SMTP_PASS=your_smtp_password_here
FROM_NAME="Aura Vital Star Concierge"
FROM_EMAIL=noreply@auravitalstar.ca
ADMIN_EMAIL=auravitalstar@gmail.com

# ============================================================
# CORS — Allowed Origins
# ============================================================
WEBSITE_URL=http://localhost:5173
CRM_URL=http://localhost:5174

# ============================================================
# File Uploads
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
